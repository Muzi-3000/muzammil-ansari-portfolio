---
import SectionBar from './SectionBar.astro';
---
<footer class="contact" id="contact" data-balance-section>
  <SectionBar eyebrow="contact" label="start a conversation" light />
  <div class="contact__main" data-reveal>
    <p class="contact__kicker">Have a project in mind?</p>
    <a class="contact__title" href="mailto:AnsariUzamil3000@gmail.com" data-magnetic>
      <span>let’s make</span><span>it matter.</span>
    </a>
    <div class="contact__asterisk" aria-hidden="true" data-parallax="-0.04">*</div>
  </div>
  <div class="contact__balance-panel">
    <input type="range" min="-100" max="100" value="0" aria-label="Adjust the composition's visual balance" data-balance-range />
  </div>
  <div class="footer-line">
    <p>muzammil ansari<br />independent designer</p>
    <div class="footer-links"><a href="mailto:AnsariUzamil3000@gmail.com">email ↗</a></div>
    <p>available for select<br />collaborations · 2026</p>
  </div>
</footer>
