---
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

type Props = {
  title?: string;
  description?: string;
  socialImage?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
};

const {
  title = 'Muzammil Ansari | Independent Designer',
  description = 'Computer engineer turned designer creating brand identities, digital experiences, packaging and campaigns with structure and purpose.',
  socialImage: socialImagePath = '/og.jpg',
  socialImageWidth = 1200,
  socialImageHeight = 631,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(socialImagePath, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f0eb" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(socialImageWidth)} />
    <meta property="og:image:height" content={String(socialImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Muzammil Ansari',
      url: Astro.site?.toString(),
      email: 'mailto:AnsariUzamil3000@gmail.com',
      jobTitle: 'Graphic Designer and UI/UX Designer',
      knowsAbout: ['Brand identity', 'UI/UX design', 'Packaging design', 'Campaign design', 'Computer engineering'],
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <slot />
  </body>
</html>
